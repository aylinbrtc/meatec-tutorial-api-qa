# Base URL of the API under test (app-under-test, run via its own docker-compose)
API_BASE_URL=http://localhost:8080/api

# Direct MongoDB connection, used for asserting DB state in tests
MONGO_URI=mongodb://localhost:27017/bezkoder_db

# Credentials for the seeded test users (created by the setup script)
TEST_ADMIN_USERNAME=test_admin
TEST_ADMIN_PASSWORD=change_me
TEST_MODERATOR_USERNAME=test_moderator
TEST_MODERATOR_PASSWORD=change_me
TEST_USER_USERNAME=test_user
TEST_USER_PASSWORD=change_me